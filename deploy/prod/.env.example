# Qanat on a server. Copy to deploy/prod/.env and fill in; `make prod-up`
# refuses to start without it. Secrets are NOT set here: they are files in
# deploy/prod/secrets/ (see docs/deploy.md).

# Public hostname, without scheme or path. The dashboard is served at
# https://$QANAT_DOMAIN, its API at /api and the gateway at /gateway
# (Claude Code: ANTHROPIC_BASE_URL=https://$QANAT_DOMAIN/gateway).
QANAT_DOMAIN=qanat.example.com

# Host port nginx listens on, plain HTTP. TLS ends in front of it
# (Cloudflare or another proxy).
QANAT_HTTP_PORT=80

# Keycloak (your existing instance). Leave QANAT_OIDC_ISSUER empty to sign in
# with the root password only. The client secret, if the client is
# confidential, goes in deploy/prod/secrets/oidc_client_secret.
QANAT_OIDC_ISSUER=https://keycloak.example.com/realms/your-realm
QANAT_OIDC_CLIENT_ID=qanat-dashboard

# Promoted to admin on first Keycloak sign-in.
BOOTSTRAP_ADMIN_EMAIL=you@example.com

# Images published by CI (.github/workflows/ci.yml). deploy.sh pulls
# $QANAT_IMAGE_REPO/qanat and /web at $IMAGE_TAG; pass a commit SHA to
# deploy.sh to roll back.
QANAT_IMAGE_REPO=ghcr.io/sajjadsaharkhan/qanat
IMAGE_TAG=latest
