{
  "realm": "qanat",
  "enabled": true,
  "displayName": "Qanat (local)",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "groups": [{ "name": "qanat-users" }],
  "clients": [
    {
      "clientId": "qanat-dashboard",
      "name": "Qanat dashboard",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:3001/*"],
      "webOrigins": ["http://localhost:3000", "http://localhost:3001"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:3000/* http://localhost:3001/*"
      },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@qanat.local",
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "groups": ["qanat-users"],
      "credentials": [{ "type": "password", "value": "alice", "temporary": false }]
    },
    {
      "username": "bob",
      "email": "bob@qanat.local",
      "firstName": "Bob",
      "lastName": "User",
      "enabled": true,
      "emailVerified": true,
      "groups": ["qanat-users"],
      "credentials": [{ "type": "password", "value": "bob", "temporary": false }]
    },
    {
      "username": "mallory",
      "email": "mallory@qanat.local",
      "firstName": "Mallory",
      "lastName": "Outsider",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "mallory", "temporary": false }]
    }
  ]
}
